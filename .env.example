# Last.fm read API credentials (no password is used).
# Get an API key at https://www.last.fm/api/account/create
# This file is loaded automatically from the current working directory.
LASTFM_USERNAME=your_lastfm_username
LASTFM_API_KEY="your_api_key"
# Optional: where settled monthly counts are cached
# LASTFM_STATS_CACHE_DIR=~/.cache/lastfm-stats
